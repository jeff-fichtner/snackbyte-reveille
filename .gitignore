# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# environment / secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
# the console's per-service logs (008). `*.log` above does NOT cover the rotated
# generation, which ends `.log.1` — hence the directory, not just the pattern.
logs/

# spec kit — downloaded extension-catalog cache, refetched on demand
.specify/extensions/.cache/

# spec-render output — regenerated from the .md sources on demand
specs/**/*.html

# os / editor
.DS_Store
Thumbs.db

# spec-kit extension machine-local overrides
.specify/extensions/*/local-config.yml
