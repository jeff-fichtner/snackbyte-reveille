# Agent configuration — copy to `agent/.env.<target>` (one file per controlled
# target, launched by `npm run start:<target>`: `start:palworld`,
# `start:satisfactory`, `start:vlc`) and fill in with real values.
#
# NOTHING HERE IS OPTIONAL AND NOTHING HAS A DEFAULT. A missing or blank value
# makes the agent refuse to start, naming the variable. That is deliberate: a
# silent fallback turns "you forgot to set this" into mysterious wrong behaviour
# later, and one of these is an admin credential.
#
# `agent/.env.*` is gitignored and MUST NOT be committed. The repository is public.
#
# ONE AGENT CONTROLS ONE TARGET. Deploy it once per target, each with its own .env:
# `TARGET` picks the adapter, and only that target's variables below are required —
# a Palworld agent is never asked for Satisfactory's or VLC's values, or vice versa.

# Which target this agent controls: `palworld`, `satisfactory`, or `vlc`. No
# default — a wrong or missing value would control the wrong target, so the agent
# refuses to start. This is the ONE value the agent branches on, and only at startup.
# (`vlc` is the media player, not a game — the agent widened from games to
# controllable targets in 003, which is why this is TARGET, not GAME.)
TARGET=palworld

# Port the agent listens on. Bound to 127.0.0.1 ONLY — the bind address is not
# configurable, so no edit here can accidentally expose it (FR-013). A second agent
# on the same box (another target) needs a DIFFERENT port here.
AGENT_PORT=8300

# Hard ceiling in milliseconds on a whole /stop — save, verify, then shutdown.
# Exceeding it fails the stop and LEAVES THE SERVER RUNNING; a stop that hangs is
# as bad as one that loses data (FR-007). Must be a positive integer. GAMES ONLY —
# a media target has no /stop and does not read this.
STOP_TIMEOUT_MS=30000

# ── TARGET=palworld ──────────────────────────────────────────────────────────
# Required only when TARGET=palworld.

# Full path to the Palworld launcher. Windows path; quote it if it has spaces.
# Note this is the LAUNCHER — it spawns PalServer-Win64-Shipping-Cmd.exe and may
# exit while the real server keeps running (research R2).
PALWORLD_EXE_PATH=C:\steamcmd\steamapps\common\PalServer\PalServer.exe

# Base URL of the Palworld REST API. Loopback — this must never be reachable
# off-box (FR-014, FR-015).
PALWORLD_REST_BASE_URL=http://127.0.0.1:8212

# Password for `AdminPassword` in PalWorldSettings.ini. REST Basic auth depends on
# it. A blank admin password is an open admin interface, so the agent refuses to
# start without one.
PALWORLD_ADMIN_PASSWORD=

# ── TARGET=satisfactory ──────────────────────────────────────────────────────
# Required only when TARGET=satisfactory. Ports: 7777/UDP is the game (forward it),
# 7777/TCP is this API (loopback only — never forward it). See m0-satisfactory.md.

# Full path to the Satisfactory dedicated-server launcher. Windows path; quote it
# if it has spaces. This is the LAUNCHER — it spawns FactoryServer-Win64-Shipping.exe.
SATISFACTORY_EXE_PATH=C:\steamcmd\steamapps\common\SatisfactoryDedicatedServer\FactoryServer.exe

# Base URL of the Satisfactory HTTPS API. Loopback, self-signed TLS. Must never be
# reachable off-box (FR-014, FR-015).
SATISFACTORY_API_BASE_URL=https://127.0.0.1:7777/api/v1

# Admin password set when the server was CLAIMED (PasswordLogin depends on it). A
# blank one is an open admin interface, so the agent refuses to start without one.
# Claiming is one-time and already done on watson (m0-satisfactory.md).
SATISFACTORY_ADMIN_PASSWORD=

# The claimed session the server auto-loads on boot and saves on /stop. Set the
# server's autoLoadSessionName to this so a launch brings the world up on its own.
SATISFACTORY_SESSION_NAME=Reveille

# ── TARGET=vlc ───────────────────────────────────────────────────────────────
# Required only when TARGET=vlc. The media player — pause/resume, not start/stop.
# Adds NO network exposure: the video plays locally and the web interface is
# loopback-only, so there is no port to forward and no firewall rule (unlike the
# games' admin APIs). One-time operator setup: in VLC, Preferences → All → Interface
# → Main interfaces, tick "Web", and under its Lua HTTP settings set a password —
# then just open the show and press play as usual (m0-vlc.md).

# Base URL of VLC's built-in HTTP web interface. Loopback, plain HTTP (no TLS), so
# the agent reaches it with native fetch and stays zero-dependency. Default port 8080.
VLC_BASE_URL=http://127.0.0.1:8080

# The password set on VLC's web interface. Basic auth uses an EMPTY username plus
# this password. A blank one means VLC returns 401 to every request, so the agent
# refuses to start without it (fail loud, not a silent 401 later).
VLC_PASSWORD=
