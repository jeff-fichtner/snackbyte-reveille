# Orchestrator configuration — copy to `orchestrator/.env` and fill in.
#
# NOTHING HERE IS OPTIONAL AND NOTHING HAS A DEFAULT. A missing or blank value
# makes the orchestrator refuse to start, naming the variable.
#
# `orchestrator/.env` is gitignored and MUST NOT be committed. The repository is
# public and DISCORD_BOT_TOKEN is a credential — leaking it hands over the bot.

# From the Discord developer portal, Bot -> Token. Secret.
DISCORD_BOT_TOKEN=

# Application (client) ID of the Discord app. Not secret, but required.
DISCORD_APPLICATION_ID=

# Each Discord guild is a TENANT — scoped to its own set of targets, isolated so its
# members see and control ONLY those, never another guild's (004). One bot serves
# every tenant. This REPLACES the old `AGENTS` + `DISCORD_GUILD_ID`: if either is set
# the orchestrator refuses to start and tells you to migrate — the old shared-target
# shape is never reinterpreted (FR-011).
#
# TENANTS is a JSON array, one entry per guild:
#   - guildId: the Discord guild id — the routing key AND the isolation boundary.
#              Unique across tenants. (Enable Developer Mode, right-click the server →
#              Copy Server ID.)
#   - name:    optional label for logs/errors; not used for routing.
#   - agents:  this guild's targets — one entry each, the SAME per-target shape as before:
#       - name:       `/start <name>` / the `/status` title. Lowercase `[a-z0-9_-]`, 1–32
#                     chars. Unique WITHIN a tenant (may repeat across tenants).
#       - url:        where that target's agent answers. The agent's URL IS its identity
#                     (Constitution I) — no target id in the contract.
#       - kind:       `game` (/start·/stop·/address) or `media` (/pause·/play). Both /status.
#       - publicPort: GAME ONLY — the port /address reports. A `media` entry MUST NOT set it.
#
# A target may be SHARED (listed under more than one guild) or EXCLUSIVE (one guild) —
# your choice, per target. A guild NOT in TENANTS is ignored (only configured, private,
# trusted guilds command anything). Any malformed/duplicate/empty entry fails loud,
# naming it. All targets are loopback on `watson` today; the moment a url points off-box
# the agent is exposed and the no-auth trade expires — a separate future spec (FR-013).
#
# TIP — dev/prod split: give your real guild the real targets, and a test guild (e.g.
# "snackbyte dev") a throwaway target, so you can try commands without touching the real
# ones. That is as much "dev environment" as this needs.
#
# Single line (what the app reads):
TENANTS=[{"guildId":"YOUR_PROD_GUILD_ID","name":"playboy lounge","agents":[{"name":"palworld","url":"http://127.0.0.1:8300","kind":"game","publicPort":8211},{"name":"satisfactory","url":"http://127.0.0.1:8301","kind":"game","publicPort":7777},{"name":"vlc","url":"http://127.0.0.1:8302","kind":"media"}]},{"guildId":"YOUR_DEV_GUILD_ID","name":"snackbyte dev","agents":[{"name":"vlc","url":"http://127.0.0.1:8302","kind":"media"}]}]
#
# The same value, formatted for reading:
#   [
#     { "guildId": "YOUR_PROD_GUILD_ID", "name": "playboy lounge", "agents": [
#         { "name": "palworld",     "url": "http://127.0.0.1:8300", "kind": "game",  "publicPort": 8211 },
#         { "name": "satisfactory", "url": "http://127.0.0.1:8301", "kind": "game",  "publicPort": 7777 },
#         { "name": "vlc",          "url": "http://127.0.0.1:8302", "kind": "media" }
#     ] },
#     { "guildId": "YOUR_DEV_GUILD_ID", "name": "snackbyte dev", "agents": [
#         { "name": "vlc",          "url": "http://127.0.0.1:8302", "kind": "media" }   // shared with prod
#     ] }
#   ]

# How long (ms) to watch a just-started server before the follow-up gives up and
# says "could not confirm" (US3, FR-029). Required — no unbounded waits. ~2 minutes
# matches the join target (SC-001); raise it for a game that loads a big world slowly.
FOLLOWUP_TIMEOUT_MS=120000
