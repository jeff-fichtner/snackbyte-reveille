# Orchestrator configuration — copy to `orchestrator/.env` and fill in.
#
# NOTHING HERE IS OPTIONAL AND NOTHING HAS A DEFAULT. A missing or blank value
# makes the orchestrator refuse to start, naming the variable.
#
# `orchestrator/.env` is gitignored and MUST NOT be committed. The repository is
# public and DISCORD_BOT_TOKEN is a credential — leaking it hands over the bot.

# From the Discord developer portal, Bot -> Token. Secret.
DISCORD_BOT_TOKEN=

# Application (client) ID of the Discord app. Not secret, but required.
DISCORD_APPLICATION_ID=

# The one Discord server the commands are registered to. Guild-scoped commands
# appear immediately; global ones take up to an hour to propagate.
DISCORD_GUILD_ID=

# Every controlled target, as a JSON array. One entry per target:
#   - name:       the label players type (`/start <name>`, or the title on `/status`).
#                 Lowercase, `[a-z0-9_-]`, 1–32 chars (Discord subcommand rules). Unique.
#   - url:        where that target's agent answers. An agent's URL IS its identity
#                 (Constitution I) — there is no target id in the contract, so a
#                 second target is just a second entry here, never a code change.
#   - kind:       `game` or `media`. Picks the verb set: a `game` gets /start·/stop·
#                 /address; a `media` gets /pause·/play. Both appear in /status.
#                 Missing or unknown → the orchestrator refuses to start (fail loud).
#   - publicPort: GAME ENTRIES ONLY — the port players connect to for THAT game,
#                 reported by /address. Games share the public IP but differ here
#                 (Palworld 8211, Satisfactory 7777), which is why /address names one.
#                 A `media` entry MUST NOT set it (media adds no network exposure —
#                 nothing to forward, nothing to address); including it fails loud.
#
# A blank/empty/one-bad-entry value makes the orchestrator refuse to start, naming
# the problem. All agents are loopback today because they share `watson`; the
# moment a url points off-box the agent is exposed and the no-auth trade expires
# (FR-013).
#
# Single line (what the app reads):
AGENTS=[{"name":"palworld","url":"http://127.0.0.1:8300","kind":"game","publicPort":8211},{"name":"satisfactory","url":"http://127.0.0.1:8301","kind":"game","publicPort":7777},{"name":"vlc","url":"http://127.0.0.1:8302","kind":"media"}]
#
# The same value, formatted for reading:
#   [
#     { "name": "palworld",     "url": "http://127.0.0.1:8300", "kind": "game",  "publicPort": 8211 },
#     { "name": "satisfactory", "url": "http://127.0.0.1:8301", "kind": "game",  "publicPort": 7777 },
#     { "name": "vlc",          "url": "http://127.0.0.1:8302", "kind": "media" }
#   ]

# How long (ms) to watch a just-started server before the follow-up gives up and
# says "could not confirm" (US3, FR-029). Required — no unbounded waits. ~2 minutes
# matches the join target (SC-001); raise it for a game that loads a big world slowly.
FOLLOWUP_TIMEOUT_MS=120000
