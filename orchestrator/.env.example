# Orchestrator configuration — copy to `orchestrator/.env` and fill in.
#
# NOTHING HERE IS OPTIONAL AND NOTHING HAS A DEFAULT. A missing or blank value
# makes the orchestrator refuse to start, naming the variable.
#
# `orchestrator/.env` is gitignored and MUST NOT be committed. The repository is
# public and DISCORD_BOT_TOKEN is a credential — leaking it hands over the bot.

# From the Discord developer portal, Bot -> Token. Secret.
DISCORD_BOT_TOKEN=

# Application (client) ID of the Discord app. Not secret, but required.
DISCORD_APPLICATION_ID=

# The one Discord server the commands are registered to. Guild-scoped commands
# appear immediately; global ones take up to an hour to propagate.
DISCORD_GUILD_ID=

# Every controlled server, as a JSON array. One entry per game:
#   - name:       the label players type (`/start <name>`). Lowercase, `[a-z0-9_-]`,
#                 1–32 chars (Discord subcommand rules). Must be unique.
#   - url:        where that server's agent answers. An agent's URL IS its identity
#                 (Constitution I) — there is no server id in the contract, so a
#                 second server is just a second entry here, never a code change.
#   - publicPort: the port players connect to for THAT game, reported by /address.
#                 Two servers share the public IP but differ here (Palworld 8211,
#                 Satisfactory 7777), which is why /address names a server.
#
# A blank/empty/one-bad-entry value makes the orchestrator refuse to start, naming
# the problem. Both agents are loopback today because they share `watson`; the
# moment a url points off-box the agent is exposed and the no-auth trade expires
# (FR-013).
#
# Single line (what the app reads):
AGENTS=[{"name":"palworld","url":"http://127.0.0.1:8300","publicPort":8211},{"name":"satisfactory","url":"http://127.0.0.1:8301","publicPort":7777}]
#
# The same value, formatted for reading:
#   [
#     { "name": "palworld",     "url": "http://127.0.0.1:8300", "publicPort": 8211 },
#     { "name": "satisfactory", "url": "http://127.0.0.1:8301", "publicPort": 7777 }
#   ]

# How long (ms) to watch a just-started server before the follow-up gives up and
# says "could not confirm" (US3, FR-029). Required — no unbounded waits. ~2 minutes
# matches the join target (SC-001); raise it for a game that loads a big world slowly.
FOLLOWUP_TIMEOUT_MS=120000
